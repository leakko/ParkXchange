# When .easignore exists, EAS uses it instead of .gitignore for the upload
# archive. Exclude google-services.json here too — cloud builds get it from
# the EAS file env `GOOGLE_SERVICES_JSON` (see app.config.ts), not from git.
node_modules/
.expo/
dist/
web-build/
android/
ios/
*.jks
*.keystore
!debug.keystore
google-services.json
google-service-account.json
*firebase-adminsdk*
*-firebase-adminsdk-*
