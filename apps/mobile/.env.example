# Shared / documented defaults. Expo also loads mode files:
#   .env.development  — Metro + emulator (committed)
#   .env.production   — release / EAS preview (committed)
#   .env.local        — optional machine overrides (gitignored)
#
# Emulator reaches the host API via 10.0.2.2 (host loopback).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8080/v1/ws
# Public street style (city zoom). Demotiles alternative:
# EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Google Sign-In (OAuth client IDs from Google Cloud Console)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
