# Shared / documented defaults. Expo mode files:
#   .env.development  — shared Metro defaults (committed)
#   .env.production   — release / EAS preview (committed)
#   .env.emulator     — API URLs for Android emulator (committed)
#   .env.device       — API URLs for a physical phone (gitignored; from example)
#   .env.development.local — active target; written by task mobile:env:* (gitignored)
#
# Prefer tasks over editing by hand:
#   task mobile:android:emulator
#   task mobile:android:device
#   task mobile:start:emulator
#   task mobile:start:device
#
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8080/v1/ws
# Public street style (city zoom). Demotiles alternative:
# EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# LocationIQ geocoding (Free tier). Required for map search / reverse.
# Put the real key in apps/mobile/.env (gitignored) or EAS secrets — not as an
# empty EXPO_PUBLIC_LOCATIONIQ_KEY= line in .env.development (that overrides).
EXPO_PUBLIC_LOCATIONIQ_KEY=
# Optional overrides:
# EXPO_PUBLIC_LOCATIONIQ_BASE_URL=https://eu1.locationiq.com/v1
# Photon = last-resort fuzzy after Autocomplete+Search fail (on by default).
# EXPO_PUBLIC_PHOTON_ENABLED=0
# EXPO_PUBLIC_PHOTON_URL=https://photon.komoot.io/api

# Google Sign-In (OAuth client IDs from Google Cloud Console)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
