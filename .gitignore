# --- Secrets & local config -------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
# Committed Expo mode files (public EXPO_PUBLIC_* only — see apps/mobile).
!apps/mobile/.env.development
!apps/mobile/.env.production
!apps/mobile/.env.emulator
!apps/mobile/.env.device.example
# .env.device and .env.development.local stay ignored (machine / active target).

# --- Go ---------------------------------------------------------------------
# go.work is a local development overlay: CI builds each module in isolation
# with GOWORK=off, so pinning it in git would hide missing requirements.
go.work
go.work.sum
bin/
*.exe
*.test
*.out
coverage.out

# --- Node / pnpm / Turborepo ------------------------------------------------
node_modules/
.turbo/
dist/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
pnpm-debug.log*

# --- Expo / React Native ----------------------------------------------------
.expo/
apps/mobile/android/
apps/mobile/ios/
*.jks
*.keystore
!debug.keystore
*.orig.*
web-build/
# Firebase Admin / FCM V1 private key — upload to EAS only, never commit.
apps/mobile/google-service-account.json
**/firebase-adminsdk*.json
**/*-firebase-adminsdk-*.json
# Client config embeds a Google API key; keep out of the public git tree.
# Still uploaded to EAS Build via apps/mobile/.easignore (not ignored there).
apps/mobile/google-services.json

# --- Task -------------------------------------------------------------------
.task/

# --- Pulumi -----------------------------------------------------------------
Pulumi.*.yaml
!Pulumi.yaml

# --- Scratch map tiles (local curl / proxy probes) --------------------------
# Vector tile dumps and TileJSON snapshots left in the repo root while
# debugging MapLibre / OpenFreeMap; never part of the product.
*.pbf
*.mvt
/planet.json
/tile_coords.txt
/t[0-9]*.gz

# --- Editors / OS -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
.tmp/

# Git worktrees (local isolation)
.worktrees/
