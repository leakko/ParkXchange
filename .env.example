# Copy to .env with `task setup`. Never commit .env.

# --- PostGIS (local docker compose) ---
POSTGRES_USER=parkxchange
POSTGRES_PASSWORD=parkxchange
POSTGRES_DB=parkxchange
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Consumed by the Go API and the migration tooling.
DATABASE_URL=postgres://parkxchange:parkxchange@localhost:5433/parkxchange?sslmode=disable

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
API_ENV=development
LOG_LEVEL=debug

# Base64-encoded 32-byte secret used to sign access tokens.
# Generate a real one with: task auth:secret
JWT_SECRET=dev-only-insecure-secret-change-me

# Deterministic spot-coordinate fuzz (separate from JWT so rotating auth
# does not reshuffle map pins). Generate with: task auth:secret
LOCATION_FUZZ_SECRET=dev-only-insecure-fuzz-secret-change-me

# Google Sign-In (OAuth Web client ID = ID-token audience). Must match
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in apps/mobile/.env.development and eas.json.
# GOOGLE_WEB_CLIENT_ID=

# Password reset email. Empty RESEND_API_KEY logs the link in development.
# RESEND_API_KEY=
# EMAIL_FROM=ParkXchange <noreply@mail.park-xchange.com>
PASSWORD_RESET_DEEP_LINK_BASE=parkxchange://auth/reset
EMAIL_VERIFY_LINK_BASE=parkxchange://auth/verify-email

# --- Mobile ---
# Client URLs live under apps/mobile/ (see apps/mobile/.env.example).
# Do NOT put EXPO_PUBLIC_* here: Task dotenv-loads this file into every task,
# and Expo will not override those vars with .env.development.local.
# Use: task mobile:android:device | mobile:android:emulator

