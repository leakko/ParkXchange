# Copy to .env with `task setup`. Never commit .env.

# --- PostGIS (local docker compose) ---
POSTGRES_USER=parkxchange
POSTGRES_PASSWORD=parkxchange
POSTGRES_DB=parkxchange
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Consumed by the Go API and the migration tooling.
DATABASE_URL=postgres://parkxchange:parkxchange@localhost:5433/parkxchange?sslmode=disable

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
API_ENV=development
LOG_LEVEL=debug

# Base64-encoded 32-byte secret used to sign access tokens.
# Generate a real one with: task auth:secret
JWT_SECRET=dev-only-insecure-secret-change-me

# --- Mobile ---
# Client URLs live under apps/mobile/ (.env.development / .env.production).
# See apps/mobile/.env.example. Do not duplicate EXPO_PUBLIC_* here.
