# Copy to deploy/hetzner/.env on the server (never commit the real file).
# Prefer letting GitHub Actions write this file from repository secrets.

# Public hostname for Caddy / Let's Encrypt (A record → server IP).
DOMAIN=api.example.com

# ghcr.io/<owner>/<repo>/api:<tag> — set by the deploy workflow.
API_IMAGE=ghcr.io/owner/parkxchange/api:main

POSTGRES_USER=parkxchange
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=parkxchange

API_ENV=production
LOG_LEVEL=info
# At least 32 bytes. Generate: openssl rand -base64 32
JWT_SECRET=change-me-also
# Separate from JWT so rotating auth does not reshuffle map pins.
LOCATION_FUZZ_SECRET=change-me-fuzz-also
# Required outside development. "*" is OK for mobile-first testing.
CORS_ALLOWED_ORIGINS=*

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SWEEP_INTERVAL=15s

# Password reset via Resend (optional). Empty → reset links only in API logs.
RESEND_API_KEY=
EMAIL_FROM=ParkXchange <noreply@mail.park-xchange.com>
PASSWORD_RESET_DEEP_LINK_BASE=https://api.example.com/v1/auth/reset
EMAIL_VERIFY_LINK_BASE=https://api.example.com/v1/auth/verify-email

# Optional Web OAuth client ID. Empty disables Google Sign-In on the API.
GOOGLE_WEB_CLIENT_ID=
