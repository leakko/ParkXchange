# Copy to deploy/hetzner/.env on the server (never commit the real file).
# Prefer letting GitHub Actions write this file from repository secrets.

# Public hostname for Caddy / Let's Encrypt (A record → server IP).
DOMAIN=api.example.com

# ghcr.io/<owner>/<repo>/api:<tag> — set by the deploy workflow.
API_IMAGE=ghcr.io/owner/parkxchange/api:main

POSTGRES_USER=parkxchange
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=parkxchange

API_ENV=production
LOG_LEVEL=info
# At least 32 bytes. Generate: openssl rand -base64 32
JWT_SECRET=change-me-also
# Required outside development. "*" is OK for mobile-first testing.
CORS_ALLOWED_ORIGINS=*

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SWEEP_INTERVAL=15s
