{
  "name": "@parkxchange/api-contract",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAPI 3.1 spec and generated TypeScript types for the ParkXchange API",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": ["openapi.yaml", "src", "oapi-codegen.yaml"],
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "check": "node ./scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@parkxchange/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "openapi-typescript": "7.10.1",
    "typescript": "catalog:"
  }
}
